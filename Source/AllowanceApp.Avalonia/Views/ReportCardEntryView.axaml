<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="360"
        Width="300 " Height="360"
        x:Class="AllowanceApp.Avalonia.Views.ReportCardEntryView"
        Title="Report Card Entry">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock Text="Enter your Report Card" FontSize="24" Margin="0,10" HorizontalAlignment="Center" FontWeight="Bold"/>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="A's:" HorizontalAlignment="Left" FontSize="18" Margin="10"/>
                <NumericUpDown Grid.Column="1" Grid.Row="0" FontSize="16" Minimum="0" Maximum="10" Increment="1" Width="150" 
                               VerticalContentAlignment="Center" Height="30" x:Name="GradeAUpDown"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                <TextBlock Grid.Column="0" Grid.Row="1" Text="B's:" HorizontalAlignment="Left" FontSize="18" Margin="10"/>
                <NumericUpDown Grid.Column="1" Grid.Row="1" FontSize="16" Minimum="0" Maximum="10" Increment="1" Width="150"
                               VerticalContentAlignment="Center" Height="30" x:Name="GradeBUpDown"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">            
                <TextBlock Grid.Column="0" Grid.Row="2" Text="C's:" HorizontalAlignment="Left" FontSize="18" Margin="10"/>
                <NumericUpDown Grid.Column="1" Grid.Row="2" FontSize="16" Minimum="0" Maximum="10" Increment="1" Width="150"
                               VerticalContentAlignment="Center" Height="30" x:Name="GradeCUpDown"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">            
                <TextBlock Grid.Column="0" Grid.Row="3" Text="D's:" HorizontalAlignment="Left" FontSize="18" Margin="10"/>
                <NumericUpDown Grid.Column="1" Grid.Row="3" FontSize="16" Minimum="0" Maximum="10" Increment="1" Width="150"
                               VerticalContentAlignment="Center" Height="30" x:Name="GradeDUpDown"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">            
                <TextBlock Grid.Column="0" Grid.Row="4" Text="F's:" HorizontalAlignment="Left" FontSize="18" Margin="10"/>
                <NumericUpDown Grid.Column="1" Grid.Row="4" FontSize="16" Minimum="0" Maximum="10" Increment="1" Width="150"
                               VerticalContentAlignment="Center" Height="30" x:Name="GradeFUpDown"/>
            </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
            <Button Content="Submit" Width="100" Margin="10" HorizontalContentAlignment="Center" Click="OnSubmitClick"/>
            <Button Content="Cancel" Width="100" Margin="10" HorizontalContentAlignment="Center" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
