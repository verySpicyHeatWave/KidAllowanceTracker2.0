<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             xmlns:vm="using:AllowanceApp.Avalonia.ViewModels"
             x:DataType="vm:AccountViewModel"
             x:Class="AllowanceApp.Avalonia.Views.AccountView">
    <Design.DataContext>
        <vm:AccountViewModel />
    </Design.DataContext>

    <StackPanel Orientation="Vertical"
                HorizontalAlignment="Center">
        <TextBlock Text="{Binding Name}"  FontSize="36" FontWeight="Bold" Margin="20" HorizontalAlignment="Center"/>
        <TabControl>
            <TabItem Header="Allowance">
                <ContentControl Content="{Binding AllowanceViewModel}" />
            </TabItem>
            <TabItem Header="Bank">
                <ContentControl Content="{Binding BankViewModel}" />
            </TabItem>
            <TabItem Header="Transactions">
                <ContentControl Content="{Binding TransactionsViewModel}" />                
            </TabItem>
        </TabControl>
        </StackPanel>
</UserControl>
